{
  "name": "lan-file-transfer",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run test && npm run build:desktop && npm run build:mobile",
    "build:desktop": "electron-vite build",
    "build:mobile": "vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint:types": "tsc --noEmit",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.lanFileTransfer",
    "productName": "LAN File Transfer",
    "asar": false,
    "artifactName": "LAN-File-Transfer-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "17674628883",
        "repo": "LAN-File"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LAN File Transfer"
    }
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "34.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
